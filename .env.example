# ─────────────────────────────────────────────────────────────
# IoT Grid Telemetry — environment configuration
# Copy to .env and adjust. Every value below has a safe default
# except DATABASE_URL, which you must point at your Postgres.
# ─────────────────────────────────────────────────────────────

# ── Service ──────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Pretty-print logs in development; set to "false" in production
LOG_PRETTY=true
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ── Postgres / TimescaleDB ───────────────────────────────────
# TimescaleDB image: postgres://postgres:postgres@localhost:5432/grid
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grid
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# ── Redis (live node cache) ──────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# How long a node's "live" reading survives without a new message.
# After this the node is considered stale/offline. Seconds.
REDIS_LIVE_TTL_SECONDS=120

# ── MQTT broker ──────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=grid-ingest-core
# Topic filter to subscribe to. `+` matches one level.
MQTT_TOPIC=grid/+/telemetry
MQTT_QOS=1
MQTT_RECONNECT_PERIOD_MS=2000
MQTT_CONNECT_TIMEOUT_MS=10000

# ── Ingestion behaviour ──────────────────────────────────────
# Buffer telemetry in memory and write in batches instead of
# one INSERT per message.
BATCH_MAX_ROWS=500
BATCH_FLUSH_INTERVAL_MS=1000
# Hard cap on the in-memory buffer. Beyond this, oldest rows are
# dropped and a warning is logged (back-pressure protection).
BATCH_MAX_BUFFER=20000

# ── Alerting ─────────────────────────────────────────────────
# Voltage below this is a "grid drop" alert.
ALERT_VOLTAGE_MIN=180
# Voltage above this is an over-voltage alert.
ALERT_VOLTAGE_MAX=260
# Suppress repeat alerts for the same node+kind within this window.
ALERT_DEDUPE_WINDOW_SECONDS=300

# ── API ──────────────────────────────────────────────────────
# Default number of history points returned per node.
API_HISTORY_DEFAULT_LIMIT=120
API_HISTORY_MAX_LIMIT=2000
# A node with no reading newer than this is reported as "stale".
API_STALE_AFTER_SECONDS=120
